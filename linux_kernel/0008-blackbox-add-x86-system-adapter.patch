--- /dev/null
+++ b/drivers/staging/blackbox/x86/Kconfig
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: GPL-2.0
+
+config BLACKBOX_X86
+	bool "Support BlackBox saving fault logs with pstore for x86"
+	depends on X86
+	depends on PSTORE_BLACKBOX
+	depends on BLACKBOX_STORAGE_BY_PSTORE_RAM
+	help
+	  System adapter for BlackBox on x86 (based on the rockchip one).
+	  Catches panic via panic_notifier and saves fault logs with
+	  pstore ram (ramoops).
