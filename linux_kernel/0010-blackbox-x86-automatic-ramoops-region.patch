diff --git a/drivers/staging/blackbox/x86/ramoops_auto.c b/drivers/staging/blackbox/x86/ramoops_auto.c
new file mode 100644
index 000000000..7a8d401df
--- /dev/null
+++ b/drivers/staging/blackbox/x86/ramoops_auto.c
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Automatic ramoops region for BlackBox on x86.
+ *
+ * With "bbox_ramoops=auto" on the kernel command line the region is chosen
+ * during early boot by a fixed rule inside the largest usable RAM range of
+ * the firmware memory map, reserved in e820 (like memmap=nn$ss), and later a
+ * "ramoops" platform device is registered for it.
+ *
+ * The same memory map gives the same address on every boot, so records
+ * survive a warm reboot. After a RAM or firmware change the region simply
+ * moves into the new usable RAM: only the record made before the change is
+ * lost, nothing is written into firmware-owned memory.
+ *
+ * Explicit ramoops.mem_address= on the command line takes precedence.
+ */
+#define pr_fmt(fmt) "bbox_ramoops: " fmt
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/sizes.h>
+#include <linux/kmsg_dump.h>
+#include <linux/platform_device.h>
+#include <linux/pstore_ram.h>
+#include <asm/e820/api.h>
+#include <asm/early_ioremap.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
+
+#define BBOX_RAMOOPS_SIZE	SZ_1M
+#define BBOX_RAMOOPS_OFFSET	SZ_256M	/* from the start of the range */
+#define BBOX_RAMOOPS_STEP	SZ_64M	/* shift on a conflict */
+#define BBOX_RAMOOPS_TRIES	8
+#define BBOX_RAMOOPS_ALIGN	SZ_2M
+
+static phys_addr_t bbox_ramoops_addr __initdata;
+
+static bool __init overlaps(u64 a, u64 alen, u64 b, u64 blen)
+{
+	return a < b + blen && b < a + alen;
+}
+
+static bool __init overlaps_setup_data(u64 start, u64 size)
+{
+	u64 pa = boot_params.hdr.setup_data;
+
+	while (pa) {
+		struct setup_data *d = early_memremap(pa, sizeof(*d));
+		u64 next, len;
+
+		if (!d)
+			return true;
+		next = d->next;
+		len = sizeof(*d) + d->len;
+		early_memunmap(d, sizeof(*d));
+		if (overlaps(start, size, pa, len))
+			return true;
+		pa = next;
+	}
+	return false;
+}
+
+static bool __init region_is_free(u64 start, u64 size)
+{
+	u64 kstart = __pa_symbol(_text);
+	u64 kend = __pa_symbol(_end);
+	u64 rd = boot_params.hdr.ramdisk_image |
+		 ((u64)boot_params.ext_ramdisk_image << 32);
+	u64 rdsz = boot_params.hdr.ramdisk_size |
+		   ((u64)boot_params.ext_ramdisk_size << 32);
+
+	if (!e820__mapped_all(start, start + size, E820_TYPE_RAM))
+		return false;
+	if (overlaps(start, size, kstart, kend - kstart))
+		return false;
+	if (rdsz && overlaps(start, size, rd, rdsz))
+		return false;
+	return !overlaps_setup_data(start, size);
+}
+
+static int __init bbox_ramoops_setup(char *arg)
+{
+	u64 best_start = 0, best_size = 0, addr;
+	int i;
+
+	if (!arg || strcmp(arg, "auto"))
+		return 0;
+	if (strstr(boot_command_line, "ramoops.mem_address=")) {
+		pr_info("ramoops.mem_address given, auto mode disabled\n");
+		return 0;
+	}
+
+	for (i = 0; i < e820_table->nr_entries; i++) {
+		struct e820_entry *e = &e820_table->entries[i];
+
+		if (e->type == E820_TYPE_RAM && e->size > best_size) {
+			best_start = e->addr;
+			best_size = e->size;
+		}
+	}
+	if (best_size < BBOX_RAMOOPS_OFFSET +
+			BBOX_RAMOOPS_TRIES * BBOX_RAMOOPS_STEP) {
+		pr_warn("no RAM range large enough\n");
+		return 0;
+	}
+
+	addr = ALIGN(best_start + BBOX_RAMOOPS_OFFSET, BBOX_RAMOOPS_ALIGN);
+	for (i = 0; i < BBOX_RAMOOPS_TRIES; i++, addr += BBOX_RAMOOPS_STEP) {
+		if (!region_is_free(addr, BBOX_RAMOOPS_SIZE))
+			continue;
+		e820__range_update(addr, BBOX_RAMOOPS_SIZE,
+				   E820_TYPE_RAM, E820_TYPE_RESERVED);
+		e820__update_table(e820_table);
+		bbox_ramoops_addr = addr;
+		pr_info("reserved %#llx-%#llx%s\n", addr,
+			addr + BBOX_RAMOOPS_SIZE - 1, i ? " (shifted)" : "");
+		return 0;
+	}
+	pr_warn("no free region found\n");
+	return 0;
+}
+early_param("bbox_ramoops", bbox_ramoops_setup);
+
+static int __init bbox_ramoops_register(void)
+{
+	struct ramoops_platform_data pdata = {
+		.mem_address	= bbox_ramoops_addr,
+		.mem_size	= BBOX_RAMOOPS_SIZE,
+		.record_size	= SZ_128K,
+		.blackbox_size	= SZ_256K,
+		.max_reason	= KMSG_DUMP_OOPS,
+		.ecc_info	= { .ecc_size = 16 },
+	};
+	struct platform_device *pdev;
+
+	if (!bbox_ramoops_addr)
+		return 0;
+	pdev = platform_device_register_data(NULL, "ramoops", -1,
+					     &pdata, sizeof(pdata));
+	if (IS_ERR(pdev)) {
+		pr_err("failed to register ramoops device: %ld\n",
+		       PTR_ERR(pdev));
+		return PTR_ERR(pdev);
+	}
+	return 0;
+}
+arch_initcall(bbox_ramoops_register);
