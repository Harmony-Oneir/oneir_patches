diff --git a/ueventd/ueventd_module_loader.c b/ueventd/ueventd_module_loader.c
new file mode 100644
index 00000000..7c8f228f
--- /dev/null
+++ b/ueventd/ueventd_module_loader.c
@@ -0,0 +1,252 @@
+/*
