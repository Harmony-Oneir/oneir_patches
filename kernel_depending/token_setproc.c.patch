 const uint64_t SET_PROC_FD_TAG = 0xD005A01;
 
+
+/*
+ * Ядро без модуля access_token_id: устройства TOKENID_DEVNODE нет.
+ * Эти значения принадлежат самому процессу, поэтому храним их у себя.
+ * Наружу токен уходит не отсюда, а через binder.
+ */
+static _Atomic uint64_t g_selfTokenId = INVAL_TOKEN_ID;
+static _Atomic uint64_t g_firstTokenId = INVAL_TOKEN_ID;
+
+
+
+
+#define TOKEN_BY_NAME_DIR "/data/service/el0/access_token/byname/"
+
+/*
+ * Ядро без модуля access_token_id не хранит токен в задаче, поэтому init
+ * не может выставить его процессу при запуске. Читаем свой токен из файла,
+ * который создаёт token_init, — по имени процесса. Тот же приём, что и в
+ * binder_invoker для токена отправителя.
+ */
+static uint64_t LoadSelfTokenByName(void)
+{
+    char cmdline[256] = {0};
+    int fd = open("/proc/self/cmdline", O_RDONLY);
+    if (fd < 0) {
+        return INVAL_TOKEN_ID;
+    }
+    ssize_t len = read(fd, cmdline, sizeof(cmdline) - 1);
+    (void)close(fd);
+    if (len <= 0) {
+        return INVAL_TOKEN_ID;
+    }
+    cmdline[len] = '\0';
+
+    char *name = strrchr(cmdline, '/');
+    name = (name != NULL) ? (name + 1) : cmdline;
+
+    char path[512];
+    if (snprintf(path, sizeof(path), "%s%s", TOKEN_BY_NAME_DIR, name) < 0) {
+        return INVAL_TOKEN_ID;
+    }
+
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return INVAL_TOKEN_ID;
+    }
+    unsigned long long value = 0;
+    int cnt = fscanf(file, "%llu", &value);
+    (void)fclose(file);
+    if (cnt != 1) {
+        return INVAL_TOKEN_ID;
+    }
+    return (uint64_t)value;
+}
+
+#define TOKEN_BY_PID_DIR "/data/service/el0/access_token/bypid/"
+
+/*
+ * Ядро не хранит токен в задаче, поэтому получатель транзакции binder не может
+ * узнать токен отправителя. Процесс оставляет запись о себе по своему
+ * идентификатору; её читает binder_invoker при разборе входящей транзакции.
+ */
+static void StoreSelfTokenByPid(uint64_t tokenID)
+{
+    char path[256];
+    if (tokenID == INVAL_TOKEN_ID) {
+        return;
+    }
+    if (snprintf(path, sizeof(path), "%s%d", TOKEN_BY_PID_DIR, (int)getpid()) < 0) {
+        return;
+    }
+    FILE *file = fopen(path, "w");
+    if (file == NULL) {
+        return;
+    }
+    (void)fprintf(file, "%llu", (unsigned long long)tokenID);
+    (void)fclose(file);
+    (void)chmod(path, 0644);
+}
+
+static uint64_t LoadSelfTokenByPid(void)
+{
+    char path[256];
+    if (snprintf(path, sizeof(path), "%s%d", TOKEN_BY_PID_DIR, (int)getpid()) < 0) {
+        return INVAL_TOKEN_ID;
+    }
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return INVAL_TOKEN_ID;
+    }
+    unsigned long long value = 0;
+    int cnt = fscanf(file, "%llu", &value);
+    (void)fclose(file);
+    if (cnt != 1 || value == 0) {
+        return INVAL_TOKEN_ID;
+    }
+    return (uint64_t)value;
+}
