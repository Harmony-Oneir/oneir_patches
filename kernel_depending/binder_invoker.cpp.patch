+
+    // Ядро без поддержки токенов возвращает ноль. Апстрим подставляет здесь
+    // uid, но он неотличим от токена приложения и ломает проверку типа.
+    // Берём настоящий токен процесса из той же таблицы, что и для отправителя.
+    uint64_t token = LookupTokenByPid(getpid());
+    return (token != 0) ? token : static_cast<uint64_t>(getuid());
+
