index b1fcadbc..9e29eaaa 100644
--- a/ipc/native/src/core/invoker/source/binder_invoker.cpp
+++ b/ipc/native/src/core/invoker/source/binder_invoker.cpp
@@ -978,6 +978,59 @@ int32_t BinderInvoker::TargetStubSendRequest(const binder_transaction_data &tr,
     return error;
 }
 
+
+static uint64_t LookupTokenByPid(pid_t pid)
+{
+
+
+    char pidPath[256];
+    if (snprintf(pidPath, sizeof(pidPath),
+                 "/data/service/el0/access_token/bypid/%d", (int)pid) > 0) {
+        FILE *file = fopen(pidPath, "r");
+        if (file != nullptr) {
+            unsigned long long value = 0;
+            int cnt = fscanf(file, "%llu", &value);
+            (void)fclose(file);
+            if (cnt == 1 && value != 0) {
+                return static_cast<uint64_t>(value);
+            }
+        }
+    }
+
+
+    char path[64] = {0};
+    if (snprintf(path, sizeof(path), "/proc/%d/cmdline", pid) < 0) {
+        return 0;
+    }
+    FILE *f = fopen(path, "r");
+    if (f == nullptr) {
+        return 0;
+    }
+    char cmdline[256] = {0};
+    size_t n = fread(cmdline, 1, sizeof(cmdline) - 1, f);
+    fclose(f);
+    if (n == 0) {
+        return 0;
+    }
+    // В cmdline аргументы разделены нулями, первый из них — путь к бинарнику.
+    const char *slash = strrchr(cmdline, '/');
+    const char *name = (slash != nullptr) ? slash + 1 : cmdline;
+
+    char tokenPath[320] = {0};
+    if (snprintf(tokenPath, sizeof(tokenPath),
+                 "/data/service/el0/access_token/byname/%s", name) < 0) {
+        return 0;
+    }
+    f = fopen(tokenPath, "r");
+    if (f == nullptr) {
+        return 0;
+    }
+    unsigned long long token = 0;
+    int matched = fscanf(f, "%llu", &token);
+    fclose(f);
+    return (matched == 1) ? static_cast<uint64_t>(token) : 0;
+}
+
 void BinderInvoker::Transaction(binder_transaction_data_secctx& trSecctx)
 {
     binder_transaction_data& tr = trSecctx.transaction_data;
@@ -1019,7 +1072,47 @@ void BinderInvoker::Transaction(binder_transaction_data_secctx& trSecctx)
         GetSenderInfo(callerTokenID_, firstTokenID_, callerRealPid_);
     } else if (binderConnector_ != nullptr && binderConnector_->IsAccessTokenSupported()) {
         GetAccessToken(callerTokenID_, firstTokenID_);
+    }else{
+        // The OpenHarmony kernel without extensions does not pass the sender's token:
+        // there is neither an `access_token_id` module nor corresponding fields in Binder.
+        // There is also no ATM service in the system, and no one issues HAP tokens,
+        // so all processes here are native. We retrieve the correct
+        // native process identifier: version 1, type 1, number based on the UID.
+       //constexpr uint64_t TOKEN_VERSION_SHIFT = 29;
+       // constexpr uint64_t TOKEN_TYPE_SHIFT = 27;
+       // constexpr uint64_t TOKEN_TYPE_NATIVE = 1;
+       // constexpr uint64_t TOKEN_VERSION = 1; // version, default 001
+       // constexpr uint64_t TOKEN_UNIQUE_MASK = 0xfffff;
+       // callerTokenID_ = (TOKEN_VERSION << TOKEN_VERSION_SHIFT) | (TOKEN_TYPE_NATIVE << TOKEN_TYPE_SHIFT) | (static_cast<uint64_t>(callerUid_) & TOKEN_UNIQUE_MASK);
+       // firstTokenID_ = callerTokenID_;
+      // Ядро без модуля access_token_id не передаёт токен отправителя.
+        // Восстанавливаем его сами: pid приходит от binder и подделке не
+        // поддаётся, имя процесса по pid даёт ядро через /proc, а
+        // соответствие имени и токена ведёт libnativetoken.
+        callerTokenID_ = LookupTokenByPid(callerPid_);
+        if (callerTokenID_ == 0) {
+            // Ядро не передало ни маркера, ни номера процесса отправителя.
+            // Все процессы на этом стенде нативные, поэтому собираем маркер
+            // нужного вида из номера пользователя: версия 1, тип 1 (нативный).
+            //constexpr uint64_t TOKEN_VERSION_SHIFT = 29;
+            //constexpr uint64_t TOKEN_TYPE_SHIFT = 27;
+            //constexpr uint64_t TOKEN_UNIQUE_MASK = 0xfffff;
+            //callerTokenID_ = (1ULL << TOKEN_VERSION_SHIFT) | (1ULL << TOKEN_TYPE_SHIFT) |
+            //                 (static_cast<uint64_t>(callerUid_) & TOKEN_UNIQUE_MASK);
+       // Односторонняя посылка: ядро не сообщает отправителя.
+            // Берём маркер принимающего процесса — он настоящий и
+            // зарегистрирован, в отличие от собранного из номера пользователя.
+            callerTokenID_ = LookupTokenByPid(getpid());
+
+        }
+
+        firstTokenID_ = callerTokenID_;
+
     }
+
