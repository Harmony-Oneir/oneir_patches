diff --git a/src/intel/vulkan/anv_ohos.c b/src/intel/vulkan/anv_ohos.c
new file mode 100644
index 00000000000..3db6bf2f7a5
--- /dev/null
+++ b/src/intel/vulkan/anv_ohos.c
@@ -0,0 +1,239 @@
+/*
+ * Copyright © 2026 Harmony-Oneir
+ * SPDX-License-Identifier: MIT
+ *
+ * VK_OHOS_native_buffer / VK_OHOS_external_memory для anv.
+ * Перенос соответствующих частей anv_android.c: вместо gralloc-дескриптора
+ * используется BufferHandle OpenHarmony (dma-buf fd, ширина, высота, stride в байтах,
+ * формат GraphicPixelFormat). Модификатора тайлинга у BufferHandle нет — буферы линейные.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <unistd.h>
+
+#include "anv_private.h"
+#include "anv_ohos.h"
+
+#include "vk_format.h"
+#include "vk_util.h"
+
+/* BufferHandle (graphic_surface: buffer_handle.h), стабильная раскладка с API 8. */
+#include "buffer_handle.h"
+
+/* graphic_surface: native_buffer_inner.h. Объявлено здесь, чтобы не тянуть C++-заголовки. */
+extern const BufferHandle *OH_NativeBuffer_GetBufferHandle(const struct OH_NativeBuffer *buffer);
+
+/* GraphicPixelFormat (graphic_surface: surface_type.h). Только RGB-форматы первого этапа;
+ * YUV (внешние форматы) — позже. */
+enum {
+   OHOS_PIXEL_FMT_RGB_565   = 3,
+   OHOS_PIXEL_FMT_RGBX_8888 = 11,
+   OHOS_PIXEL_FMT_RGBA_8888 = 12,
+   OHOS_PIXEL_FMT_RGB_888   = 13,
+   OHOS_PIXEL_FMT_BGRX_8888 = 19,
+   OHOS_PIXEL_FMT_BGRA_8888 = 20,
+};
+
+VkFormat
+anv_ohos_to_vk_format(int32_t ohos_format)
+{
+   switch (ohos_format) {
+   case OHOS_PIXEL_FMT_RGBA_8888:
+   case OHOS_PIXEL_FMT_RGBX_8888: return VK_FORMAT_R8G8B8A8_UNORM;
+   case OHOS_PIXEL_FMT_BGRA_8888:
+   case OHOS_PIXEL_FMT_BGRX_8888: return VK_FORMAT_B8G8R8A8_UNORM;
+   case OHOS_PIXEL_FMT_RGB_565:   return VK_FORMAT_R5G6B5_UNORM_PACK16;
+   case OHOS_PIXEL_FMT_RGB_888:   return VK_FORMAT_R8G8B8_UNORM;
+   default:                       return VK_FORMAT_UNDEFINED;
+   }
+}
+
+static VkResult
+ohos_handle_layout(struct anv_device *device, const BufferHandle *h,
+                   struct anv_ohos_buffer_layout *out)
+{
+   if (!h || h->fd < 0)
+      return vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "OHOS buffer handle has no dma-buf fd");
+
+   out->width = h->width;
+   out->height = h->height;
+   out->stride_B = h->stride;
+   out->ohos_format = h->format;
+   out->vk_format = anv_ohos_to_vk_format(h->format);
+   return VK_SUCCESS;
+}
+
+/* anv (по соглашению VkNativeBufferANDROID) ждёт шаг строки в пикселях. */
+static VkResult
+ohos_stride_in_pixels(struct anv_device *device, VkFormat format,
+                      uint32_t stride_B, uint32_t *stride_px)
+{
+   const uint32_t cpp = vk_format_get_blocksize(format);
+   if (cpp == 0 || stride_B % cpp != 0)
+      return vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "OHOS buffer stride %u B is not a multiple of %u B per pixel",
+                       stride_B, cpp);
+   *stride_px = stride_B / cpp;
+   return VK_SUCCESS;
+}
+
+static VkResult
+ohos_bind_bo_checked(struct anv_device *device, struct anv_image *image,
+                     struct anv_bo *bo)
+{
+   VkMemoryRequirements2 mem_reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+   };
+   anv_image_get_memory_requirements(device, image, image->vk.aspects, &mem_reqs);
+
+   const VkDeviceSize aligned_image_size =
+      align64(mem_reqs.memoryRequirements.size, mem_reqs.memoryRequirements.alignment);
+   if (bo->size < aligned_image_size)
+      return vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "dma-buf from OHOS buffer is too small for VkImage: "
+                       "%" PRIu64 "B < %" PRIu64 "B", bo->size, aligned_image_size);
+
+   assert(!image->disjoint);
+   assert(image->n_planes == 1);
+   assert(image->bindings[ANV_IMAGE_MEMORY_BINDING_MAIN].address.bo == NULL);
+   image->bindings[ANV_IMAGE_MEMORY_BINDING_MAIN].address.bo = bo;
+   /* Изображение владеет импортированным bo — тот же механизм, что для gralloc. */
+   image->from_gralloc = true;
+   return VK_SUCCESS;
+}
+
+VkResult
+anv_image_init_from_ohos_buffer(struct anv_device *device,
+                                struct anv_image *image,
+                                const VkImageCreateInfo *base_info,
+                                const VkNativeBufferOHOS *nb_info)
+{
+   const BufferHandle *h = (const BufferHandle *)nb_info->handle;
+   struct anv_ohos_buffer_layout layout;
+   VkResult result = ohos_handle_layout(device, h, &layout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   uint32_t stride_px;
+   result = ohos_stride_in_pixels(device, base_info->format, layout.stride_B, &stride_px);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* dma-buf принадлежит BufferHandle: не закрываем, только импортируем. */
+   struct anv_bo *bo = NULL;
+   result = anv_device_import_bo(device, h->fd, ANV_BO_ALLOC_EXTERNAL,
+                                 0 /* client_address */, &bo);
+   if (result != VK_SUCCESS)
+      return vk_errorf(device, result, "failed to import dma-buf from VkNativeBufferOHOS");
+
+   struct anv_image_create_info anv_info = {
+      .vk_info = base_info,
+      .isl_extra_usage_flags = ISL_SURF_USAGE_DISABLE_AUX_BIT,
+      .isl_tiling_flags = ISL_TILING_LINEAR_BIT,
+      .stride = stride_px,
+   };
+   result = anv_image_init(device, image, &anv_info);
+   if (result != VK_SUCCESS)
+      goto fail_init;
+
+   result = ohos_bind_bo_checked(device, image, bo);
+   if (result != VK_SUCCESS)
+      goto fail_bind;
+
+   return VK_SUCCESS;
+
+fail_bind:
+   anv_image_finish(image);
+fail_init:
+   anv_device_release_bo(device, bo);
+   return result;
+}
+
+VkResult
+anv_image_bind_from_ohos_buffer(struct anv_device *device,
+                                struct anv_image *image,
+                                const VkNativeBufferOHOS *nb_info)
+{
+   const BufferHandle *h = (const BufferHandle *)nb_info->handle;
+   if (!h || h->fd < 0)
+      return vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "VkNativeBufferOHOS has no dma-buf fd");
+
+   struct anv_bo *bo = NULL;
+   VkResult result = anv_device_import_bo(device, h->fd, ANV_BO_ALLOC_EXTERNAL,
+                                          0 /* client_address */, &bo);
+   if (result != VK_SUCCESS)
+      return vk_errorf(device, result, "failed to import dma-buf from VkNativeBufferOHOS");
+
+   result = ohos_bind_bo_checked(device, image, bo);
+   if (result != VK_SUCCESS)
+      anv_device_release_bo(device, bo);
+   return result;
+}
+
+VkResult
+anv_import_ohos_buffer_memory(struct anv_device *device,
+                              struct anv_device_memory *mem,
+                              const VkImportNativeBufferInfoOHOS *info,
+                              struct anv_ohos_buffer_layout *layout)
+{
+   const BufferHandle *h = OH_NativeBuffer_GetBufferHandle(info->buffer);
+   VkResult result = ohos_handle_layout(device, h, layout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return anv_device_import_bo(device, h->fd, ANV_BO_ALLOC_EXTERNAL,
+                               0 /* client_address */, &mem->bo);
+}
+
+VkResult
+anv_GetNativeBufferPropertiesOHOS(VkDevice device_h,
+                                  const struct OH_NativeBuffer *buffer,
+                                  VkNativeBufferPropertiesOHOS *pProperties)
+{
+   ANV_FROM_HANDLE(anv_device, dev, device_h);
+
+   const BufferHandle *h = OH_NativeBuffer_GetBufferHandle(buffer);
+   if (!h || h->fd < 0)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   VkNativeBufferFormatPropertiesOHOS *fmt =
+      vk_find_struct(pProperties->pNext, NATIVE_BUFFER_FORMAT_PROPERTIES_OHOS);
+   if (fmt) {
+      fmt->format = anv_ohos_to_vk_format(h->format);
+      fmt->externalFormat = 0; /* внешние (YUV) форматы — следующий этап */
+
+      VkFormatProperties2 props = { .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2 };
+      if (fmt->format != VK_FORMAT_UNDEFINED) {
+         dev->physical->vk.dispatch_table.GetPhysicalDeviceFormatProperties2(
+            vk_physical_device_to_handle(&dev->physical->vk), fmt->format, &props);
+      }
+      /* Буфер линейный — возможности формата для линейного тайлинга. */
+      fmt->formatFeatures = props.formatProperties.linearTilingFeatures;
+      fmt->samplerYcbcrConversionComponents = (VkComponentMapping) {
+         VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+         VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+      };
+      fmt->suggestedYcbcrModel = VK_SAMPLER_YCBCR_MODEL_CONVERSION_RGB_IDENTITY;
+      fmt->suggestedYcbcrRange = VK_SAMPLER_YCBCR_RANGE_ITU_FULL;
+      fmt->suggestedXChromaOffset = VK_CHROMA_LOCATION_MIDPOINT;
+      fmt->suggestedYChromaOffset = VK_CHROMA_LOCATION_MIDPOINT;
+   }
+
+   off_t size = lseek(h->fd, 0, SEEK_END);
+   pProperties->allocationSize = size > 0 ? (VkDeviceSize)size : (VkDeviceSize)h->size;
+   pProperties->memoryTypeBits = (1ull << dev->physical->memory.type_count) - 1;
+   return VK_SUCCESS;
+}
+
+VkResult
+anv_GetMemoryNativeBufferOHOS(VkDevice device_h,
+                              const VkMemoryGetNativeBufferInfoOHOS *pInfo,
+                              struct OH_NativeBuffer **pBuffer)
+{
+   /* Экспорт памяти Vulkan в OH_NativeBuffer — следующий этап; RS его не использует. */
+   (void)device_h; (void)pInfo; (void)pBuffer;
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+}
diff --git a/src/intel/vulkan/anv_ohos.h b/src/intel/vulkan/anv_ohos.h
new file mode 100644
index 00000000000..0d86fb37753
--- /dev/null
+++ b/src/intel/vulkan/anv_ohos.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright © 2026 Harmony-Oneir
+ * SPDX-License-Identifier: MIT
+ *
+ * VK_OHOS_native_buffer / VK_OHOS_external_memory для anv.
+ */
+#ifndef ANV_OHOS_H
+#define ANV_OHOS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+#include "util/detect_os.h"
+
+struct anv_device;
+struct anv_image;
+struct anv_device_memory;
+struct OH_NativeBuffer;
+
+/* Раскладка буфера OpenHarmony, нужная anv для описания изображения.
+ * Буферы OpenHarmony (BufferHandle) не несут модификатор тайлинга: они линейные. */
+struct anv_ohos_buffer_layout {
+   uint32_t width;
+   uint32_t height;
+   uint32_t stride_B;       /* шаг строки в байтах, как в BufferHandle::stride */
+   int32_t  ohos_format;    /* GraphicPixelFormat */
+   VkFormat vk_format;
+};
+
+/* Типы внешней памяти OH_NativeBuffer: для изображений с ними раскладка
+ * откладывается до vkBindImageMemory, как для AHardwareBuffer (image->from_ahb). */
+#if DETECT_OS_OHOS
+#define ANV_OHOS_EXTERNAL_HANDLE_TYPES \
+   (VK_EXTERNAL_MEMORY_HANDLE_TYPE_OH_NATIVE_BUFFER_BIT_OHOS | \
+    VK_EXTERNAL_MEMORY_HANDLE_TYPE_OHOS_NATIVE_BUFFER_BIT_OHOS)
+#else
+#define ANV_OHOS_EXTERNAL_HANDLE_TYPES 0
+#endif
+
+#if DETECT_OS_OHOS
+
+VkFormat anv_ohos_to_vk_format(int32_t ohos_format);
+
+/* Путь swapchain: VkNativeBufferOHOS в цепочке VkImageCreateInfo / VkBindImageMemoryInfo. */
+VkResult anv_image_init_from_ohos_buffer(struct anv_device *device,
+                                         struct anv_image *image,
+                                         const VkImageCreateInfo *base_info,
+                                         const VkNativeBufferOHOS *nb_info);
+
+VkResult anv_image_bind_from_ohos_buffer(struct anv_device *device,
+                                         struct anv_image *image,
+                                         const VkNativeBufferOHOS *nb_info);
+
+/* Путь RS: VkImportNativeBufferInfoOHOS в vkAllocateMemory.
+ * Импортирует dma-buf в mem->bo и запоминает раскладку в *layout для
+ * последующего vkBindImageMemory. */
+VkResult anv_import_ohos_buffer_memory(struct anv_device *device,
+                                       struct anv_device_memory *mem,
+                                       const VkImportNativeBufferInfoOHOS *info,
+                                       struct anv_ohos_buffer_layout *layout);
+
+#endif /* DETECT_OS_OHOS */
+
+#endif /* ANV_OHOS_H */
